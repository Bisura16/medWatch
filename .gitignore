# virtual envs
anggota1/.venv/
**/.venv/
**/venv/
.venv-desktop/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
build/
dist/
*.egg-info/
*.so

# Node (if any subdir uses it)
node_modules/

# Desktop backend binaries (built natively per OS by PyInstaller / CI, not committed)
**/resources/medwatch-backend
**/resources/medwatch-backend.exe

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Logs (except anggota1/scraper.log which is preserved teammate evidence per ADR-0004)
*.log
!anggota1/scraper.log

# Scraper run artefacts (logs from local module runs)
anggota1/scraper.log

# Env files (except example)
.env
.env.*
.env.local
!.env.example

# Build artifacts
*.spec
!ProductionGrade-ImplementationPlan/build/medwatch.spec
!medwatch_desktop.spec

# openFDA scrape outputs (large; shipped via GitHub Releases or build process)
anggota1/Hasil-Scrap/drugs.db
anggota1/Hasil-Scrap/drugs.db-shm
anggota1/Hasil-Scrap/drugs.db-wal
installer-based app/resources/drugs.db
portable-app/resources/drugs.db

# Windows backend binary (bundled into installer/portable .exe)
installer-based app/resources/medwatch-backend.exe
portable-app/resources/medwatch-backend.exe
dist-windows/

# Electron builder per-variant output (the .exe artifacts ship outside git)
installer-based app/dist/
portable-app/dist/
installer-based app/node_modules/
portable-app/node_modules/

# Scraper transient state (checkpoint db and progress log)
.scrape-cache/

# macOS Finder duplicate-suffix noise (filename like 'foo 2.ext')
*[[:space:]][0-9]*.db
*[[:space:]][0-9]*.db-shm
*[[:space:]][0-9]*.db-wal
*[[:space:]][0-9]*.sqlite
*[[:space:]][0-9]*.sqlite-shm
*[[:space:]][0-9]*.sqlite-wal
*[[:space:]][0-9]*.jsonl

# Secrets and credentials (never commit values; use Secret Manager / env)
*.pem
*.key
service-account*.json
gcp-key*.json

# Per-install JWT secret (runtime generated)
api/data/.jwt_secret
