---
title: "Deployment Diagram MedWatch"
config:
  theme: default
  flowchart:
    htmlLabels: true
---
flowchart TB
  classDef node fill:#FFFFFF,stroke:#1F4E79,stroke-width:2px,color:#1F4E79
  classDef container fill:#DCE6F1,stroke:#1F4E79,stroke-width:1px,color:#1F4E79
  classDef ext fill:#F2F2F2,stroke:#7F7F7F,stroke-width:1px,color:#404040
  classDef legend fill:#FFF8E1,stroke:#8C7B00,stroke-width:1px,color:#5C5200

  title["Diagram Deployment MedWatch (Topologi Fisik)"]:::legend

  subgraph CLIENT["Node Klien"]
    direction TB
    browser["Browser Pengguna<br/>Chrome/Firefox/Safari<br/>(httpOnly cookie JWT)"]:::container
  end

  subgraph VERCEL["Vercel Edge Network (global CDN)"]
    direction TB
    vercel_build["Vercel Build<br/>Node 22 LTS<br/>next build"]:::container
    vercel_runtime["Vercel Runtime<br/>Next.js 15 App Router<br/>asia-southeast1 edge POP"]:::container
    proxy["Proxy Middleware<br/>src/middleware/proxy.ts<br/>/api/[...slug] -> Cloud Run"]:::container
  end

  subgraph GCP["GCP Project medwatch-polban-2026 (asia-southeast1)"]
    direction TB
    subgraph RUN["Cloud Run Service medwatch-api"]
      direction TB
      gunicorn["gunicorn 2 worker<br/>Flask 3 app<br/>api/app.py:create_app()"]:::container
    end
    subgraph STORAGE["Cloud Storage"]
      gcs["GCS Bucket<br/>medwatch-polban-2026-state<br/>users.json + patients.json"]:::container
    end
    subgraph SECRETS["Secret Manager"]
      sm["Secret medwatch-jwt-secret<br/>(IAM: roles/secretmanager.secretAccessor)"]:::container
    end
  end

  subgraph FDA["Region eksternal: US-East AWS"]
    direction TB
    openfda["openFDA API<br/>api.fda.gov/drug/event.json<br/>api.fda.gov/drug/enforcement.json"]:::ext
  end

  browser ==>|"HTTPS:443<br/>same-origin<br/>(Set-Cookie httpOnly)"| vercel_runtime
  vercel_build -. "deploy" .-> vercel_runtime
  vercel_runtime --> proxy
  proxy ==>|"HTTPS:443<br/>Bearer JWT"| gunicorn
  gunicorn ==>|"google-cloud-storage<br/>IAM: ObjectAdmin"| gcs
  gunicorn ==>|"Secret Manager API<br/>(boot)"| sm
  gunicorn ==>|"HTTPS:443<br/>api_key=...<br/>(rate 120000/hari)"| openfda

  legend["LEGENDA NOTASI DEPLOYMENT<br/>------------------------------<br/>Node = mesin fisik atau logikal (Browser, Vercel Edge, Cloud Run, GCS, openFDA).<br/>Container shape = unit deploy di dalam node (worker, bucket, secret).<br/>Garis tebal (==>) = jalur runtime utama dengan label protokol+port.<br/>Garis putus (-..-> ) = pipeline build/deploy bukan runtime.<br/>Label berisi protokol (HTTPS), port (443), atau credential mechanism (IAM, Bearer JWT).<br/>Region label tercantum pada subgraph (asia-southeast1, US-East)."]:::legend

  style CLIENT fill:#F9F9F9,stroke:#1F4E79
  style VERCEL fill:#F0F4FF,stroke:#1F4E79
  style GCP fill:#E6F2EA,stroke:#1F7A3A
  style FDA fill:#FCEEE7,stroke:#A85128
