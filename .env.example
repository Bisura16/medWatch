# OpenFDA API key. Get one free at https://open.fda.gov/apis/authentication/.
# Without a key, the rate limit is 1,000 req/day per IP. With a key it is 120,000/day.
OPENFDA_API_KEY=<your-key-here>

# JWT signing secret. Any random string for dev. Production: GCP Secret Manager.
JWT_SECRET=<random-string-for-dev>

# Backend port (default 8080)
PORT=8080

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Cloud Storage toggle (true on Cloud Run, false locally)
USE_CLOUD_STORAGE=false

# GCS bucket name (the bucket is medwatch-polban-2026-state in production)
GCS_BUCKET=medwatch-polban-2026-state

# GCP project ID
GCP_PROJECT_ID=medwatch-polban-2026
