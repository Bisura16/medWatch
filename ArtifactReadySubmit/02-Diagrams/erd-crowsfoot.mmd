---
title: "ERD Crow's Foot - Logical Data Model MedWatch"
---
erDiagram
  USER ||--o{ PATIENT : "owns (owner_username FK)"
  USER ||--o{ PATIENT : "created (created_by FK)"
  PATIENT ||--|| VISIT_SOAP : "current visit (1-to-1, schema flat)"
  VISIT_SOAP }o--o{ DRUG : "prescribes (P.resep parsed)"
  DRUG ||--o{ SIDE_EFFECT : "has"
  DRUG ||--o{ RECALL : "recalled as"
  DRUG ||--o{ ADVERSE_EVENT : "reported in"

  USER {
    string username PK "username unik (login id)"
    string password_hash "bcrypt cost 12"
    string role "tenaga_kesehatan masyarakat admin"
    string name
    string phone
  }

  PATIENT {
    string id PK "format Pxxx auto"
    string nama
    int umur
    string alamat
    string tanggal_kunjungan "DD-MM-YYYY"
    string kategori "kehamilan KB lansia balita imunisasi umum"
    string owner_username FK "ref USER.username"
    string created_by FK "ref USER.username"
  }

  VISIT_SOAP {
    string patient_id PK "ref PATIENT.id"
    string S_keluhan
    string S_riwayat
    string O_tekanan_darah
    string O_nadi
    string O_suhu_c
    string O_respirasi
    string O_bb_kg
    string O_tb_cm
    string O_lila_cm
    string O_catatan
    string A_diagnosa
    string P_tindakan
    string P_resep
    string P_jadwal_kontrol
  }

  DRUG {
    string nama_obat PK
    string kategori
    string bahan_aktif "multi-valued, JSON array"
    string indikasi "multi-valued"
    string dosis_umum
    string kehamilan
  }

  SIDE_EFFECT {
    string nama_efek PK
    string kategori
    string tingkat_keparahan "ringan sedang serius"
    string rekomendasi
  }

  RECALL {
    string recall_number PK
    string product_description
    string reason_for_recall
    string classification "Class I Class II Class III"
    string recall_initiation_date
  }

  ADVERSE_EVENT {
    string safetyreportid PK
    string receivedate
    string reactionmeddrapt "multi-valued"
    string medicinalproduct "multi-valued"
  }
